# ==============================================================================
# VanDrishti Environment Configuration Template
# Nainital Forest Division, Uttarakhand, India
# Copy this file to .env and configure your local settings
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-prototype-key-for-local-development-only
ALLOWED_HOSTS=127.0.0.1,localhost

# NASA FIRMS API Integration
# Obtain a free 32-character Map Key at: https://firms.modaps.eosdis.nasa.gov/api/
# When set, VanDrishti can fetch live Near-Real-Time (NRT) satellite thermal anomaly data
FIRMS_MAP_KEY=

# Default Satellite Sensor Stream (Options: VIIRS_NOAA20_NRT, VIIRS_SNPP_NRT, VIIRS_NOAA21_NRT, MODIS_NRT)
FIRMS_DEFAULT_SOURCE=VIIRS_NOAA20_NRT

# Nainital Bounding Box Coordinates (min_lng,min_lat,max_lng,max_lat)
NAINITAL_BBOX=79.10,29.10,79.80,29.65
